# ===== Web =====
# ポータルの公開 URL。パスキーの origin 検証とクッキーの Secure 判定に使う。
# 本番では https 必須。開発では未設定なら http://localhost:<PORT> になる。
WEB_ORIGIN=
PORT=3000

# WebAuthn の Relying Party。未設定なら WEB_ORIGIN のホスト名と "orangebot" になる。
RP_ID=
RP_NAME=

# ===== 秘密情報 =====
# 本番では必須。開発では未設定でも動くが、その旨の警告が出る。
# 生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# base64 で 32 バイト。TOTP の秘密鍵を保存時に暗号化する鍵。
APP_ENCRYPTION_KEY=

# ===== データベース =====
DATABASE_PATH=data/orangebot.db

# ===== Discord（任意。未設定なら Web だけで動く）=====
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# 開発用サーバーの ID。指定するとスラッシュコマンドが即時反映される。
DISCORD_GUILD_ID=1410224334450069629
# 提案の開始と決着を流すチャンネルの ID。
DISCORD_PROPOSAL_CHANNEL_ID=

# ===== その他 =====
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
