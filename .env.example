# ===== Web =====
# ポータルの公開 URL。パスキーの origin 検証とクッキーの Secure 判定に使う。
# 本番では https 必須。開発では未設定なら http://localhost:<PORT> になる。
WEB_ORIGIN=https://mail.shudo-physics.com
# 証明書を指定したときの既定は 443、指定しなければ 3000。
PORT=443

# ===== TLS =====
# node が自分で https を終端する。本番では必須で、指定が無ければ起動しない。
# Let's Encrypt の置き場所。certbot が置き換えたら、そのまま読み直す。
TLS_CERT_PATH=/etc/letsencrypt/live/mail.shudo-physics.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/mail.shudo-physics.com/privkey.pem

# WebAuthn の Relying Party。未設定なら WEB_ORIGIN のホスト名と "orangebot" になる。
RP_ID=
RP_NAME=

# ===== 秘密情報 =====
# 本番では必須。開発では未設定でも動くが、その旨の警告が出る。
# 生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# base64 で 32 バイト。TOTP の秘密鍵を保存時に暗号化する鍵。
APP_ENCRYPTION_KEY=

# ===== データベース =====
DATABASE_PATH=data/orangebot.db

# ===== Discord（任意。未設定なら Web だけで動く）=====
# bot は送るだけで、受け取らない。投票も設定も Web でしか行えない。
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# Discord Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=1549750279199789076
# 所属サーバーの ID。
DISCORD_GUILD_ID=1410224334450069629
# 提案の開始と決着を流すチャンネルの ID。
DISCORD_PROPOSAL_CHANNEL_ID=1410446126150062100

# ===== OAG ノード（任意。未設定なら残高を出さない）=====
# 合言葉の置き場所。ノードが起動のたびに書き直す。これを指定したときだけ繋ぐ。
OAG_COOKIE_PATH=/home/tokumoto/orange/oag-data/.cookie
# mainnet | testnet | regtest
OAG_NETWORK=mainnet
# 既定はネットワークごとのループバック（mainnet なら http://127.0.0.1:9445）。
OAG_RPC_URL=

# ===== 値動きの予想 =====
# 上がるか下がるか (5 分)、終値予想と値幅予想 (1 時間) を BOAG で予想する。Web からだけ遊べる。
# 取引所のシンボルをカンマで並べる。none で止める (順位予想も止まる)。既定は BTCUSDT,ETHUSDT。
PREDICTION_SYMBOLS=BTCUSDT,ETHUSDT
# 順位予想 (1 時間でいちばん伸びる銘柄) で比べる銘柄。2 つ以上。none で順位予想だけ止める。
RANKING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
# 足を取り寄せる先。既定は Binance の公開 API。
PRICE_API_BASE_URL=

# ===== 外部の bot との pt の交換 =====
# 10,000,000 pt = 1 BOAG。仕様は docs/EXCHANGE_API.md。
# 相手の bot と共有する署名の秘密。32 文字以上。設定したときだけ API が開く。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXCHANGE_SECRET=
# 相手の受け口の URL。パスまで書く。未設定なら出金 (BOAG -> pt) は受け付けない。
# orangebot 側の API は /api/orangebot-boag-pt-exchange/v1/... に開く。
EXCHANGE_PARTNER_URL=https://oogiri-bot-cfy1.onrender.com/api/orangebot-boag-pt-exchange/v1/pt-deposits
# 1 回の上限と、24 時間の入金の合計の上限 (pt)。秘密が漏れたときの被害を抑える。
EXCHANGE_MAX_PT_PER_REQUEST=100000000000
EXCHANGE_MAX_PT_PER_DAY=1000000000000

# ===== その他 =====
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
